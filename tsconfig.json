{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "uniflex-sdk": ["./packages/sdk/src/index.ts"],
      "uniflex-sdk/react": ["./packages/sdk/src/react.tsx"],
      "uniflex-sdk/*": ["./packages/sdk/src/*"]
    }
  },
  "include": ["src/**/*", "packages/**/*", "scripts/**/*", "test/**/*"]
}
